[Unit]
Description=Tequis Magico - panel y API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=tequis
WorkingDirectory=/srv/tequis/web-admin
EnvironmentFile=/etc/tequis/panel.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3100
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
