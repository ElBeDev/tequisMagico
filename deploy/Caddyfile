{
	skip_install_trust
}

(comun) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
}

tequismagico.com {
	import comun
	# web/proxy.ts hace rewrite con request.nextUrl: con X-Forwarded-Proto https lo arma como
	# https://localhost:3000/... y Next intenta proxy TLS a su propio puerto (500 en todo).
	# localhost y no 127.0.0.1: el servicio arranca con -H localhost (ver tequis-web.service), que
	# en este servidor escucha en ::1; Caddy prueba las dos direcciones de localhost.
	reverse_proxy localhost:3000 {
		header_up X-Forwarded-Proto http
	}
}

www.tequismagico.com {
	redir https://tequismagico.com{uri} permanent
}

panel.tequismagico.com {
	import comun
	request_body {
		max_size 12MB
	}
	handle_path /uploads/* {
		root * /srv/tequis/uploads
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}
